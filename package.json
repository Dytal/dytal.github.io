{
  "name": "neurax-launcher",
  "productName": "Neurax Launcher",
  "version": "1.0.0",
  "description": "Neurax Launcher NX — a real Minecraft launcher with device-bound NX identity, NX Cloud on your own Supabase database (5s auto-refresh, remote lock, chat ≤100MB, announcements) and the NX-UI 64x resource pack.",
  "author": "Anish Sandeep Bharagav",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:all": "electron-builder -mwl",
    "test:core": "node scripts/test-core.js"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "minecraft-launcher-core": "^3.18.1"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.16.1"
  },
  "build": {
    "appId": "com.neurax.launcher",
    "productName": "Neurax Launcher",
    "copyright": "Copyright (c) 2026 Anish Sandeep Bhargav. All rights reserved.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Neurax Launcher"
    },
    "portable": {
      "artifactName": "Neurax-Launcher-Portable-${version}.exe"
    }
  }
}
